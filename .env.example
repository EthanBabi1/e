# Copy to .env.local and fill in. See REVIEW.md for what's a real credential
# you must supply vs. what can stay a local/dev value.

# --- Database (Neon Postgres, or any local Postgres for dev) ---
DATABASE_URL="postgres://user:password@localhost:5432/podium_row"

# --- Auth.js ---
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_RESEND_KEY=""

# --- Stripe (TEST MODE ONLY — this build refuses to boot Stripe with a live key) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Resend (email) ---
RESEND_API_KEY="re_..."

# --- Anthropic (Path B results extraction from photos/PDFs) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Uploads (UploadThing or S3-compatible) ---
UPLOADTHING_TOKEN=""

# --- Feature flags ---
# MYLAPS transponder import (Path A). Off by default — see DATA-ACCESS.md.
# Only flip this on after confirming actual API access terms with MYLAPS.
FEATURE_MYLAPS_IMPORT="false"

# --- Admin/owner ---
OWNER_EMAIL="ebabil888@gmail.com"

# --- Cron protection ---
CRON_SECRET="generate-a-random-string"
